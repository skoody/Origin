{
    "name": "6 Wings",
    "description": "Flight is your usual thing but you are a very calm creature. You have creative flight but at the cost of speed",
    "type": "origins:multiple",
    "toggle": {
        "type": "origins:toggle",
        "active_by_default": false,
        "key": {
            "key": "key.saveToolbarActivator"
        },
        "conditions": [
            {
                "type": "origins:resource",
                "resource": "angel:global/holiness",
                "comparison": ">=",
                "compare_to": 50
            }
        ],
        "retain_state": false
    },
    "flight": {
        "type": "origins:creative_flight",
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:power_active",
                    "power": "*:*_toggle"
                },
                {
                    "type": "origins:resource",
                    "resource": "angel:global/holiness",
                    "comparison": ">=",
                    "compare_to": 50
                }
            ]
        }
    },
    "drain": {
        "type": "origins:action_over_time",
        "interval": 20,
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "angel:global/holiness",
            "change": -50
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:power_active",
                    "power": "*:*_toggle"
                },
                {
                    "type": "origins:resource",
                    "resource": "angel:global/holiness",
                    "comparison": ">=",
                    "compare_to": 50
                }
            ]
        }
    }
}