{
    "type": "origins:multiple",
    "toggle": {
        "type": "origins:toggle",
        "active_by_default": false,
        "key": {
            "key": "key.origins.primary_active"
        },
        "conditions": [
            {
                "type": "origins:resource",
                "resource": "angel:4/holiness",
                "comparison": ">=",
                "compare_to": 100
            }
        ],
        "retain_state": false
    },
    "phase": {
        "type": "origins:phasing",
        "blacklist": true,
        "render_type": "blindness",
        "view_distance": 16,
        "block_condition": {
            "type": "origins:in_tag",
            "tag": "origins:unphasable"
        },
        "phase_down_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:sneaking"
                },
                {
                    "type": "origins:on_block"
                }
            ]
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:power_active",
                    "power": "angel:4/phase"
                },
                {
                    "type": "origins:resource",
                    "resource": "angel:global/holiness",
                    "comparison": ">=",
                    "compare_to": 100
                },
                {
                    "type": "origins:power_active",
                    "power": "*:*_toggle"
                }
            ]
        }
    },
    "drain": {
        "type": "origins:action_over_time",
        "interval": 20,
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "angel:4/holiness",
            "change": -100
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:power_active",
                    "power": "*:*_toggle"
                },
                {
                    "type": "origins:resource",
                    "resource": "angel:4/holiness",
                    "comparison": ">=",
                    "compare_to": 100
                }
            ]
        }
    }
}